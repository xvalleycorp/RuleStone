      "version": "2",
      "asOf": "2026-12-01",
      "facts": {
        "applicant": { "age": 19, "monthlyIncome": 30000000, "monthlyDebt": 0, "segment": "RETAIL", "blacklisted": false },
        "amount": 1000000
      },
      "expect": {
        "output": { "decision": "REJECT" },
        "reasonCodes": ["UNDERAGE"],
        "ruleVersion": "2"
      }
    },
    {
