      "asOf": "2026-06-15",
      "facts": {
        "applicant": { "age": 30, "monthlyIncome": 30000000, "monthlyDebt": 0, "segment": "RETAIL", "blacklisted": false },
        "amount": 200000000
      },
      "expect": {
        "output": { "decision": "REVIEW", "limit": null },
        "reasonCodes": ["AMOUNT_ABOVE_LIMIT"],
        "matchedRules": ["R3"]
      }
    },
    {
      "name": "explicit version 2 ignores the date",
