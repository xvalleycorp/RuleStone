      "asOf": "2026-10-31",
      "facts": {
        "applicant": { "age": 19, "monthlyIncome": 30000000, "monthlyDebt": 0, "segment": "RETAIL", "blacklisted": false },
        "amount": 1000000
      },
      "expect": {
        "output": { "decision": "REJECT", "limit": null },
        "reasonCodes": ["UNDERAGE"],
        "matchedRules": ["R1"],
        "ruleVersion": "2"
      }
    },
    {
      "name": "amount within 6 monthly incomes is approved",
      "asOf": "2026-06-15",
      "facts": {
        "applicant": { "age": 30, "monthlyIncome": 25750000.50, "monthlyDebt": 5000000, "segment": "RETAIL", "blacklisted": false },
        "amount": 150000000
      },
      "expect": {
        "output": { "decision": "APPROVE", "limit": 154500003.00 },
        "exactOutput": true,
        "reasonCodes": [],
        "matchedRules": ["R2"]
      }
    },
    {
      "name": "high debt is not checked before version 3",
      "asOf": "2026-06-15",
      "facts": {
        "applicant": { "age": 30, "monthlyIncome": 20000000, "monthlyDebt": 15000000, "segment": "RETAIL", "blacklisted": false },
        "amount": 100000000
      },
      "expect": {
        "output": { "decision": "APPROVE", "limit": 120000000 },
        "reasonCodes": [],
        "matchedRules": ["R2"]
      }
    },
    {
