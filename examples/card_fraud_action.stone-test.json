    {
      "name": "everyday grocery purchase is approved",
      "description": "Documented scenario in docs/examples.md: score 0 from no signal",
      "facts": {
        "riskScore": 0,
        "transaction": { "amount": 450000, "channel": "POS" }
      },
      "expect": {
        "output": { "action": "APPROVE" },
        "exactOutput": true,
        "reasonCodes": [],
        "matchedRules": ["APPROVE"]
      }
    },
    {
      "name": "foreign night-time online purchase from a new device is challenged",
