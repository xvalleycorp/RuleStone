        "riskScore": 65,
        "transaction": { "amount": 6000000, "channel": "ECOM" }
      },
      "expect": {
        "output": { "action": "CHALLENGE" },
        "exactOutput": true,
        "reasonCodes": ["RISK_SCORE_HIGH"],
        "matchedRules": ["CHALLENGE_HIGH"]
      }
    },
