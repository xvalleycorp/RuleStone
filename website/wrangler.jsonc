// Cloudflare Worker that serves the static site built by VitePress.
// Deploy with `npm run deploy` (see README.md).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rulestone-website",
  "compatibility_date": "2026-10-01",

  // Static assets only; no Worker script is needed.
  "assets": {
    "directory": "./src/.vitepress/dist",
    // VitePress builds with cleanUrls: /docs/java-api serves docs/java-api.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  // Serve only on the custom domain, not on *.workers.dev or preview URLs.
  "routes": [{ "pattern": "rulestone.dxa.io.vn", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
