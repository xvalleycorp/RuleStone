<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>vn.io.dxa.rulestone</groupId>
        <artifactId>rulestone-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>rulestone-temporal</artifactId>
    <name>RuleStone Temporal</name>
    <description>Temporal (Java SDK) integration: a decision activity, in-workflow evaluation pinned to the rule version recorded in workflow history, search attributes and exact-decimal payload conversion.</description>

    <dependencies>
        <dependency>
            <groupId>vn.io.dxa.rulestone</groupId>
            <artifactId>rulestone-api</artifactId>
        </dependency>
        <!-- Users bring their own Temporal SDK version; RuleStone does not redistribute it. -->
        <dependency>
            <groupId>io.temporal</groupId>
            <artifactId>temporal-sdk</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Exact-decimal payload (de)serializers. The Temporal SDK depends on Jackson too. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>vn.io.dxa.rulestone</groupId>
            <artifactId>rulestone-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.temporal</groupId>
            <artifactId>temporal-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
