<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>vn.io.dxa.rulestone</groupId>
        <artifactId>rulestone-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>rulestone-camunda8</artifactId>
    <name>RuleStone Camunda 8</name>
    <description>Camunda 8 (Zeebe) job worker that evaluates RuleStone decisions from BPMN service tasks, with a Camunda Modeler element template.</description>

    <properties>
        <!--
          Compiled and tested against this version. It is a provided dependency: applications bring
          their own Camunda client, and RuleStone does not redistribute it.
        -->
        <camunda-client.version>8.10.6</camunda-client.version>
        <mockito.version>5.24.0</mockito.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>vn.io.dxa.rulestone</groupId>
            <artifactId>rulestone-api</artifactId>
        </dependency>
        <!-- Decision tables: their declared input types let the integration read process variables. -->
        <dependency>
            <groupId>vn.io.dxa.rulestone</groupId>
            <artifactId>rulestone-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>io.camunda</groupId>
            <artifactId>camunda-client-java</artifactId>
            <version>${camunda-client.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
