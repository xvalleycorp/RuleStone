<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>vn.io.dxa.rulestone</groupId>
        <artifactId>rulestone-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>rulestone-camunda7</artifactId>
    <name>RuleStone Camunda 7</name>
    <description>Camunda 7 JavaDelegate, process engine plugin and expression bean that evaluate RuleStone decisions from BPMN processes.</description>

    <properties>
        <!--
          Compiled and tested against this version. It is a provided dependency: applications bring
          their own Camunda engine, and RuleStone does not redistribute it.
        -->
        <camunda7.version>7.24.0</camunda7.version>
        <h2.version>2.3.232</h2.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>vn.io.dxa.rulestone</groupId>
            <artifactId>rulestone-api</artifactId>
        </dependency>
        <!-- Decision tables: their declared input types let the integration read process variables. -->
        <dependency>
            <groupId>vn.io.dxa.rulestone</groupId>
            <artifactId>rulestone-core</artifactId>
        </dependency>
        <!-- FactsJson takes JSON trees; core depends on Jackson as well. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.camunda.bpm</groupId>
            <artifactId>camunda-engine</artifactId>
            <version>${camunda7.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Silences SLF4J's "no binding" notice in tests; the engine's slf4j-api version. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.20</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
