<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Standalone (no parent) so consumers importing the BOM inherit nothing else. -->
    <groupId>vn.io.dxa.rulestone</groupId>
    <artifactId>rulestone-bom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>RuleStone BOM</name>
    <description>Bill of materials that aligns the versions of all RuleStone modules.</description>
    <url>https://rulestone.dxa.io.vn</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>rulestone-authors</id>
            <name>The RuleStone Authors</name>
            <url>https://github.com/xvalleycorp/RuleStone/blob/main/AUTHORS</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/xvalleycorp/RuleStone.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/xvalleycorp/RuleStone.git</developerConnection>
        <url>https://github.com/xvalleycorp/RuleStone</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/xvalleycorp/RuleStone/issues</url>
    </issueManagement>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>vn.io.dxa.rulestone</groupId>
                <artifactId>rulestone-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>vn.io.dxa.rulestone</groupId>
                <artifactId>rulestone-cel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>vn.io.dxa.rulestone</groupId>
                <artifactId>rulestone-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>vn.io.dxa.rulestone</groupId>
                <artifactId>rulestone-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>vn.io.dxa.rulestone</groupId>
                <artifactId>rulestone-editor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>vn.io.dxa.rulestone</groupId>
                <artifactId>rulestone-temporal</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
